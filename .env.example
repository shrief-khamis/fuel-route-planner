# Copy to .env and adjust. Never commit .env.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# "true" or "false". Must be false in production.
DJANGO_DEBUG=true

# Comma-separated hostnames, no spaces.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Routing ---

# Which routing adapter to use: "openrouteservice" or "fake" (offline, no API key needed).
ROUTING_PROVIDER=openrouteservice

# Seconds to wait to open a connection to the provider.
ROUTING_CONNECT_TIMEOUT_SECONDS=5

# Seconds to wait for the provider's response. Long truck routes can take a few
# seconds to compute; keep this below your web server/proxy timeout (often 30s).
ROUTING_TIMEOUT_SECONDS=15

# OpenRouteService (https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=
# Change only if you self-host ORS.
ORS_BASE_URL=https://api.heigit.org/openrouteservice

# --- Logging ---

# Minimum level for our own code: DEBUG, INFO, WARNING, ERROR or CRITICAL.
# Dependencies (Django, httpx, ...) only log WARNING and above.
LOG_LEVEL=INFO

# Console output format: "plain" (human-readable) or "json" (one object per line).
LOG_CONSOLE_FORMAT=plain

# "true" to also write JSON logs to LOG_DIR/app.log, rotated by size.
LOG_FILE_ENABLED=false
# Relative paths are relative to the project root.
LOG_DIR=logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
