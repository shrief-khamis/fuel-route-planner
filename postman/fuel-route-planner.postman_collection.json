{
  "info": {
    "name": "Fuel Route Planner",
    "description": "Requests for `GET /api/find-route/`. Set the `baseUrl` collection variable to where the server runs (default `http://localhost:8000`). Each request has tests that check the response, and a saved example from a real run against openrouteservice, with the route `points` trimmed to four.\n\nThe optional fuel settings are listed on each request, disabled. Enable one to override its default; the tests read the settings from the request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Long route: New York to Los Angeles",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const METRES_PER_MILE = 1609.344;",
              "const query = pm.request.url.query.toObject(true);",
              "const maxRange = Number(query.max_range_miles ?? 500);",
              "const startFuel = Number(query.start_fuel_miles ?? maxRange);",
              "const reserve = Number(query.reserve_miles ?? 0);",
              "const mpg = Number(query.mpg ?? 10);",
              "const body = pm.response.json();",
              "const routeMiles = body.distance_m / METRES_PER_MILE;",
              "",
              "// Distances in the response are rounded to 0.1 mi and offsets to 0.01 mi.",
              "const MILES_TOLERANCE = 0.5;",
              "",
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "",
              "pm.test('The route is longer than the usable start fuel, so it needs stops', () => {",
              "    pm.expect(routeMiles).to.be.above(startFuel - reserve);",
              "    pm.expect(body.stops).to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "pm.test('Stops are in travel order', () => {",
              "    const along = body.stops.map(s => s.distance_from_start_miles);",
              "    pm.expect(along).to.eql([...along].sort((a, b) => a - b));",
              "});",
              "",
              "// Walk the trip from start to finish, tracking the fuel in the tank.",
              "console.log(`${body.start.lat},${body.start.lon} -> ${body.finish.lat},${body.finish.lon}: ` +",
              "    `${routeMiles.toFixed(1)} mi, ${body.stops.length} stops, start fuel ${startFuel} mi`);",
              "let fuel = startFuel;",
              "let position = 0;",
              "body.stops.forEach((stop, i) => {",
              "    const s = stop.station;",
              "    const leg = stop.distance_from_start_miles - position;",
              "    fuel -= leg + stop.offset_miles;",
              "    console.log(`Stop ${i + 1}: ${s.name}, ${s.address}, ${s.city} ${s.state} at mile ` +",
              "        `${stop.distance_from_start_miles} (${stop.offset_miles} mi off route). ` +",
              "        `Arrive with ${stop.fuel_on_arrival_miles} mi, buy ${stop.gallons} gal ` +",
              "        `(${stop.fuel_added_miles} mi) at $${stop.price_per_gallon}/gal = $${stop.cost}`);",
              "",
              "    pm.test(`Stop ${i + 1} (${s.city}, ${s.state}): arrival fuel matches the distance driven`, () => {",
              "        pm.expect(stop.fuel_on_arrival_miles).to.be.closeTo(fuel, MILES_TOLERANCE);",
              "        pm.expect(stop.fuel_on_arrival_miles).to.be.at.least(reserve);",
              "    });",
              "    pm.test(`Stop ${i + 1} (${s.city}, ${s.state}): gallons and cost add up`, () => {",
              "        pm.expect(stop.gallons).to.be.closeTo(stop.fuel_added_miles / mpg, 0.01);",
              "        pm.expect(stop.cost).to.be.closeTo(stop.gallons * stop.price_per_gallon, 0.05);",
              "    });",
              "",
              "    fuel = stop.fuel_on_arrival_miles + stop.fuel_added_miles;",
              "    pm.test(`Stop ${i + 1} (${s.city}, ${s.state}): the tank is not overfilled`, () => {",
              "        pm.expect(fuel).to.be.at.most(maxRange + MILES_TOLERANCE);",
              "    });",
              "    fuel -= stop.offset_miles;",
              "    position = stop.distance_from_start_miles;",
              "});",
              "fuel -= routeMiles - position;",
              "console.log(`Finish: arrive with ${fuel.toFixed(1)} mi of fuel. ` +",
              "    `Total ${body.total_gallons} gal, $${body.total_cost}, ${body.total_detour_miles} mi of detours`);",
              "",
              "pm.test('The last stop buys just enough to reach the finish above the reserve', () => {",
              "    pm.expect(fuel).to.be.closeTo(reserve, 1);",
              "});",
              "",
              "pm.test('Totals are the sums of the stops', () => {",
              "    const sum = key => body.stops.reduce((total, s) => total + s[key], 0);",
              "    const n = body.stops.length;",
              "    pm.expect(body.total_cost).to.be.closeTo(sum('cost'), 0.01);",
              "    pm.expect(body.total_gallons).to.be.closeTo(sum('gallons'), 0.01 * n);",
              "    pm.expect(body.total_detour_miles).to.be.closeTo(2 * sum('offset_miles'), 0.01 * n);",
              "});",
              "",
              "// Open the Visualize tab of the response to see the stops as a table.",
              "pm.visualizer.set(`",
              "<style>",
              "  body { font-family: sans-serif; font-size: 13px; }",
              "  table { border-collapse: collapse; }",
              "  th, td { padding: 4px 8px; border-bottom: 1px solid #ddd; text-align: right; }",
              "  th:nth-child(2), td:nth-child(2) { text-align: left; }",
              "  tfoot td { font-weight: bold; }",
              "</style>",
              "<p>{{routeMiles}} mi, {{stops.length}} stops. A tank filled to {{maxRange}} mi is in bold.</p>",
              "<table>",
              "  <thead><tr><th>#</th><th>Station</th><th>Mile</th><th>Arrive with (mi)</th>",
              "    <th>Leaves with (mi)</th><th>Gallons</th><th>$/gal</th><th>Cost</th></tr></thead>",
              "  <tbody>",
              "  {{#each stops}}",
              "    <tr><td>{{n}}</td><td>{{name}}<br><small>{{where}}</small></td><td>{{mile}}</td>",
              "      <td>{{arrival}}</td><td>{{#if full}}<b>{{leaves}}</b>{{else}}{{leaves}}{{/if}}</td>",
              "      <td>{{gallons}}</td><td>{{price}}</td><td>\\${{cost}}</td></tr>",
              "  {{/each}}",
              "  </tbody>",
              "  <tfoot><tr><td></td><td>Total</td><td></td><td></td><td></td><td>{{totalGallons}}</td>",
              "    <td></td><td>\\${{totalCost}}</td></tr></tfoot>",
              "</table>`, {",
              "    routeMiles: routeMiles.toFixed(1),",
              "    maxRange,",
              "    totalGallons: body.total_gallons,",
              "    totalCost: body.total_cost.toFixed(2),",
              "    stops: body.stops.map((stop, i) => ({",
              "        n: i + 1,",
              "        name: stop.station.name,",
              "        where: `${stop.station.address}, ${stop.station.city}, ${stop.station.state}`,",
              "        mile: stop.distance_from_start_miles,",
              "        arrival: stop.fuel_on_arrival_miles,",
              "        leaves: Number((stop.fuel_on_arrival_miles + stop.fuel_added_miles).toFixed(1)),",
              "        full: stop.fuel_on_arrival_miles + stop.fuel_added_miles >= maxRange - MILES_TOLERANCE,",
              "        gallons: stop.gallons,",
              "        price: stop.price_per_gallon,",
              "        cost: stop.cost.toFixed(2),",
              "    })),",
              "});"
            ]
          }
        }
      ],
