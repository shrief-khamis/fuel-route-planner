          "script": {
            "type": "text/javascript",
            "exec": [
              "const METRES_PER_MILE = 1609.344;",
              "const query = pm.request.url.query.toObject(true);",
              "const maxRange = Number(query.max_range_miles ?? 500);",
              "const startFuel = Number(query.start_fuel_miles ?? maxRange);",
              "const reserve = Number(query.reserve_miles ?? 0);",
              "const mpg = Number(query.mpg ?? 10);",
              "const body = pm.response.json();",
              "const routeMiles = body.distance_m / METRES_PER_MILE;",
              "",
              "console.log(`${routeMiles.toFixed(1)} mi on the road, ${startFuel - reserve} mi of usable start fuel`);",
              "",
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "",
              "pm.test('The route is under 500 mi and the start fuel covers it', () => {",
              "    pm.expect(routeMiles).to.be.below(500);",
              "    pm.expect(routeMiles).to.be.below(startFuel - reserve);",
              "});",
              "",
              "pm.test('No fuel stops are needed', () => {",
              "    pm.expect(body.stops).to.eql([]);",
              "});",
              "",
              "pm.test('Nothing is bought, so the totals are zero', () => {",
              "    pm.expect(body.total_cost).to.equal(0);",
              "    pm.expect(body.total_gallons).to.equal(0);",
              "    pm.expect(body.total_detour_miles).to.equal(0);",
              "});",
              "",
              "pm.test('The route itself is still returned', () => {",
              "    pm.expect(body.points).to.be.an('array').with.length.above(1);",
              "});"
            ]
          }
        }
      ],
